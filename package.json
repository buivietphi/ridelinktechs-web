{
  "name": "ridelinks-techs-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,md,json}\"",
    "check:content": "tsx scripts/check-content.mts",
    "check:i18n": "tsx scripts/check-i18n.mts",
    "gen:og": "tsx scripts/gen-og.tsx",
    "admin:create": "tsx --env-file=.env.production scripts/admin-create.mts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:content && npm run check:i18n"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@thumbmarkjs/thumbmarkjs": "1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "lucide-react": "^0.469.0",
    "next": "15.5.4",
    "next-intl": "^3.26.3",
    "next-themes": "^0.4.4",
    "phosphor-react": "^1.4.1",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
