# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files.
# `.env.development` and `.env.production` are deliberately NOT ignored: the
# owner chose to track them so a fresh clone is deployable without hand-copying
# secrets. Both hold SUPABASE_SERVICE_ROLE_KEY, which bypasses RLS — if this
# repo ever goes public, rotate that key first.
.env*.local
.env

# Vercel
.vercel

# MCP server config. Holds a Supabase personal access token in the
# Authorization header, so it must never be committed.
.mcp.json

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Impeccable review artifacts (build outputs, never source)
/.impeccable/build/
/.impeccable/review/
/.impeccable/mocks/
