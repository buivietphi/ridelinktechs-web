# Blank template. The project keeps .env.development and .env.production tracked.
# Development: Next.js reads .env.development; .env.development.local overrides it.
# Production: inject at runtime through Dokploy Environment, docker --env-file,
# or a read-only secret mounted at /app/.env.production.
# The production image builds without credentials and excludes all .env files.
# Runtime process.env values take precedence over Next.js environment files.

# --- Supabase (project qyqhoegexqmzdzrosztm, shared with VibeHolic) ---
# The contact table is dedicated to RideLink Techs; VibeHolic's tables are
# never touched.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---
# siteverify secret. Server-only.
TURNSTILE_SECRET_KEY=
# Public widget key. This one is read by the server component and handed to the
# form as a prop rather than inlined with NEXT_PUBLIC_, so it is picked up at
# request time and needs no rebuild to change.
TURNSTILE_SITE_KEY=

# --- Contact form tuning ---
# Random string that never leaves the server. Salts the IP hash, so an unsalted
# SHA-256 (trivially reversible over 4 billion IPv4 guesses) is not what lands
# in the table. Keep it identical across deploys, or one visitor lands in a new
# rate-limit bucket on every restart.
CONTACT_IP_PEPPER=

# Optional, comma-separated. When set, a Turnstile token that verifies against
# the secret but carries a different hostname is rejected. Leave empty to accept
# any hostname; every accepted hostname is logged either way.
CONTACT_ALLOWED_HOSTNAMES=

# --- Development only ---
# For local development only, Cloudflare's OFFICIAL DUMMY KEYS validate on any
# host including localhost:
#
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# A production secret rejects a dummy token, so the pairs must never be mixed.

# Deliberately NOT provided:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY — the write is 100% server-side. Shipping an
#   anon key to the browser would invite a browser-side insert that the
#   table's deny-all RLS posture is designed to block.
