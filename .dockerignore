# Only production build inputs enter the build context or intermediate layers.
**
!Dockerfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.mjs
!tsconfig.json
!postcss.config.mjs
!eslint.config.mjs
!src/
!src/**
!public/
!public/**

# Keep credentials out even if someone places them under an allowed directory.
**/.env*
**/.mcp.json
**/*.pem
**/*.key
**/.DS_Store
